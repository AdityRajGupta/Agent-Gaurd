# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres
# Auth
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
MCP_SERVER_TOKEN=replace-with-a-long-random-internal-token
# LLM (Phase 4; use local Ollama or free-tier providers)
LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=

# ML service
ML_SERVICE_URL=http://ml-service:8001
